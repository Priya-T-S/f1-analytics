# Leave both Turso values empty to use the local SQLite file (backend/f1_analytics.db).
# Get them from https://app.turso.tech : create a database, then "Create token".
TURSO_DATABASE_URL=''
TURSO_AUTH_TOKEN=''

# Any long random string. Vercel sends it to /api/cron/sync so only the cron can trigger a sync.
CRON_SECRET=

PORT=5000
